# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.

# ---------- Claude (Anthropic) ----------
# Crie a chave em https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Modelo e nível de raciocínio (low é rápido e suficiente para atendimento)
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_ESFORCO=low

# ---------- WhatsApp Cloud API (Meta) ----------
# Token de acesso permanente (usuário do sistema) - veja docs/CONFIGURAR-META.md
WHATSAPP_TOKEN=
# "Identificação do número de telefone" (Phone number ID), em WhatsApp > Configuração da API
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha qualquer inventada por você; a mesma vai no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=troque-por-uma-senha-longa
# Chave secreta do app (Configurações do app > Básico). Recomendado: confere que o webhook veio da Meta
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Template aprovado para avisar atendentes (opcional, mas recomendado).
# Sem ele, o aviso só chega se o atendente tiver mandado mensagem para o número da empresa nas últimas 24h.
WHATSAPP_TEMPLATE_AVISO=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR

# ---------- Atendentes (WhatsApp de quem recebe os protocolos) ----------
# Formato com DDI e DDD, só números. Um mesmo número pode atender vários departamentos.
ATENDENTE_COMERCIAL=
ATENDENTE_FINANCEIRO=
ATENDENTE_SUPORTE=
ATENDENTE_ATENDIMENTO=

# ---------- Geral ----------
PORT=3000
# Depois de quantas horas sem mensagem a conversa volta ao menu inicial
HORAS_EXPIRACAO_CONVERSA=24
ARQUIVO_DADOS=./data/banco.json
